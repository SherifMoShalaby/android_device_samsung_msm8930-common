# Legacy HALv1 runs passthrough in cameraserver.
typeattribute cameraserver system_executes_vendor_violators;
allow cameraserver vendor_file:file { read open getattr execute map };
allow cameraserver video_device:dir r_dir_perms;
allow cameraserver video_device:chr_file rw_file_perms;
allow cameraserver camera_socket:sock_file write;

# Legacy libmmjpeg.so has text relocations; violates an AOSP neverallow; documented exception for this device only.
allow cameraserver vendor_file:file execmod;
